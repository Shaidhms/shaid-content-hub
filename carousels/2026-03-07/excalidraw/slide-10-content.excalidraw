      "width": 366.3,
      "height": 25.2,
      "text": "After your first chat, go to Settings",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
      "id": "832463df",
      "type": "text",
      "x": 40,
      "y": 141,
      "width": 277.20000000000005,
      "height": 25.2,
      "text": "Find \"KV Cache Quantization\"",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
      "id": "4578a75d",
      "type": "text",
      "x": 40,
      "y": 192,
      "width": 227.70000000000002,
      "height": 25.2,
      "text": "Switch from f16 to q4_0",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
      "id": "7c72542d",
      "type": "text",
      "x": 40,
      "y": 243,
      "width": 356.40000000000003,
      "height": 25.2,
      "text": "This roughly triples inference speed",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
      "id": "a82a0dd1",
      "type": "text",
      "x": 40,
      "y": 279,
      "width": 247.50000000000003,
      "height": 25.2,
      "text": "with minimal quality loss",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
      "id": "e64746f5",
      "type": "text",
      "x": 40,
      "y": 330,
      "width": 356.40000000000003,
      "height": 25.2,
      "text": "Also: First message is always slower",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
      "id": "cad9da25",
      "type": "text",
      "x": 40,
      "y": 366,
      "width": 297.0,
      "height": 25.2,
      "text": "as the model loads into memory",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2D2D2D",
      "roughness": 1
    },
    {
